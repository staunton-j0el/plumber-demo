---
import "../styles/global.css";
import EmergencyBanner from "../components/EmergencyBanner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { business, ogAlt } from "../data/site";

/**
 * Shared document shell: skip link, emergency banner, header, footer, and meta.
 * @param title - Document title, already including the demo credit.
 * @param description - Unique meta description. Must say this is a demo.
 * @param noindex - When true, ask crawlers not to index the page (used by the 404).
 */
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonical.href,
  isPartOf: {
    "@type": "WebSite",
    name: "Finch & Flange Plumbing demo",
    publisher: {
      "@type": "Organization",
      name: "JS Web Services",
      description: "Joel's small web design business for local businesses.",
    },
  },
  about: {
    "@type": "Thing",
    name: "Fictional plumber website concept",
    description: `${business.name} is not a real business. Prices, reviews, licence numbers, the address, and the phone number are examples.`,
  },
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="JS Web Services" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" content="#1b3d30" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JS Web Services demo" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="font-sans text-ink antialiased">
    <a class="skip-link" href="#content">Skip to content</a>
    <EmergencyBanner />
    <Header />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
