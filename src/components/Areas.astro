---
import { areaGroups } from "../data/site";

/** Example suburbs, grouped so a household can see whether their side of town is listed. */
---

<section id="areas" class="section bg-foam" aria-labelledby="areas-heading">
  <div class="mx-auto w-full max-w-6xl px-5">
    <p class="eyebrow">Service areas</p>
    <h2 id="areas-heading">Suburbs across Brisbane and South East Queensland</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed">
      An example round for a Brisbane van. Real travel time depends on the day, the traffic on Coronation Drive, and whether the job is an emergency.
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        areaGroups.map((group) => (
          <article class="card">
            <h3>{group.name}</h3>
            <p class="mt-1 text-base text-muted">{group.note}</p>
            <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-base">
              {group.places.map((place) => (
                <li>{place}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
