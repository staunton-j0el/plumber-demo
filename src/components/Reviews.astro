---
import { reviews } from "../data/site";

/** Three sample reviews. Each card says it is a sample, in the badge and in the caption. */
---

<section id="reviews" class="section" aria-labelledby="reviews-heading">
  <div class="mx-auto w-full max-w-6xl px-5">
    <p class="eyebrow">Reviews</p>
    <h2 id="reviews-heading">Sample reviews</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted">
      Written for this demo. They are not from real customers, and they are not a star rating.
    </p>
    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {
        reviews.map((review) => (
          <figure class="card flex flex-col">
            <span class="badge w-fit">Sample review</span>
            <span class="quote-mark mt-3" aria-hidden="true">
              “
            </span>
            <blockquote class="mt-2 flex-1">
              <p class="text-lg leading-relaxed">{review.quote}</p>
            </blockquote>
            <figcaption class="mt-4 text-base font-bold">
              Sample customer · {review.suburb}
              <span class="mt-1 block font-normal text-muted">Not a real customer.</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
