---
import Logo from "./Logo.astro";
import { business, navItems } from "../data/site";

/** Footer with example contact details and a plain statement that this is a JS Web Services concept. */
const footerLinks = [...navItems, { href: "/#map", label: "Map" }];
---

<footer class="bg-pine-deep text-paper">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-5 py-12 md:grid-cols-3">
    <div>
      <a class="logo" href="/">
        <Logo />
        <span>
          <span class="logo-name">{business.shortName}</span>
          <span class="logo-sub">Concept demo</span>
        </span>
      </a>
      <p class="mt-4 max-w-sm text-base leading-relaxed text-mist">
        <strong class="text-paper">A concept demo by JS Web Services</strong>{" "}
        for local businesses. {business.name} is fictional and is not a trading plumber.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-xl">On this page</h2>
      <ul class="footer-links mt-2">
        {
          footerLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-xl">Example contact</h2>
      <ul class="mt-3 space-y-3 text-base leading-relaxed text-mist">
        <li>
          <a class="inline-flex min-h-12 items-center font-bold text-paper underline decoration-1 underline-offset-4" href={business.phoneHref}>
            {business.phoneDisplay}
          </a>
          <span class="mt-1 block">Fiction number reserved by the ACMA. Not a plumber.</span>
        </li>
        <li>
          <span class="font-bold text-paper">{business.email}</span>
          <span class="mt-1 block">Example address only. It is not a real inbox.</span>
        </li>
        <li>{business.address} (example address only)</li>
        <li>{business.hours}</li>
        <li>Example ABN {business.abn}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="mx-auto w-full max-w-6xl px-5 py-5 text-sm leading-relaxed text-mist">
      © 2026 JS Web Services. Original concept and illustrations. Prices, reviews, licence numbers, the address, and the phone number are examples.
    </p>
  </div>
</footer>
