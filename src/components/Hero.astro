---
import { business } from "../data/site";

/**
 * Job-docket hero. The headline is a stencil, not a script line.
 * A copper pipe underlines it and ends in a flange at the call panel.
 */
---

<section class="hero-sheet" aria-labelledby="hero-heading">
  <div class="blueprint-marks" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-5">
    <article class="docket">
      <div class="docket-head">
        <p>Job docket <span class="docket-no">FF-014</span></p>
        <p>Plumbing · Brisbane</p>
        <p class="docket-stamp">Fiction</p>
      </div>
      <div class="docket-body">
        <h1 id="hero-heading" class="docket-title">
          <span>Blocked.</span>
          <span>Leaking.</span>
          <span>No hot water.</span>
        </h1>
        <p class="docket-lede">
          Drains, hot water, leaks, gas fitting, and bathroom renovations across Brisbane and South East Queensland.
        </p>
        <svg class="pipe-svg" viewBox="0 0 760 132" role="presentation" focusable="false">
          <path
            class="pipe-tube"
            d="M12 42H668q36 0 36 36v28"
            fill="none"
            stroke="#C46A3A"
            stroke-width="18"
            stroke-linecap="butt"
            stroke-linejoin="round"></path>
          <path
            d="M12 42H668q36 0 36 36v22"
            fill="none"
            stroke="#F3D2BE"
            stroke-width="8"
            stroke-linecap="butt"
            stroke-linejoin="round"></path>
          <rect x="168" y="30" width="16" height="24" rx="2" fill="#8E3E16"></rect>
          <rect x="430" y="30" width="16" height="24" rx="2" fill="#8E3E16"></rect>
          <path
            class="pipe-flow"
            d="M18 42H668q36 0 36 36v18"
            fill="none"
            stroke="#1E5168"
            stroke-width="3.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <g class="pipe-drip">
            <path
              d="M176 60c2.4 6 2.2 10 0 16-1.4 3.4-1.2 5.2.2 8"
              fill="none"
              stroke="#1E5168"
              stroke-width="2.6"
              stroke-linecap="round"></path>
          </g>
          <g class="pipe-drip pipe-drip-late">
            <path
              d="M438 60c2.2 5 2 8.4 0 13"
              fill="none"
              stroke="#1E5168"
              stroke-width="2.4"
              stroke-linecap="round"></path>
          </g>
          <circle cx="704" cy="112" r="16" fill="#12281F" stroke="#C46A3A" stroke-width="4"></circle>
          <circle cx="704" cy="112" r="4.2" fill="#C46A3A"></circle>
          <circle cx="704" cy="100" r="2.1" fill="#C46A3A"></circle>
          <circle cx="704" cy="124" r="2.1" fill="#C46A3A"></circle>
          <circle cx="692" cy="112" r="2.1" fill="#C46A3A"></circle>
          <circle cx="716" cy="112" r="2.1" fill="#C46A3A"></circle>
        </svg>
        <div class="tool-panel">
          <div class="tool-copy">
            <p class="tool-kicker"><span class="live-dot" aria-hidden="true"></span> Emergency?</p>
            <p class="tool-title">We're on the tools.</p>
          </div>
          <div class="tool-actions">
            <a class="btn btn-light btn-call" href={business.phoneHref}>Call {business.phoneDisplay}</a>
            <a class="tool-quote" href="#quote">Request a quote</a>
          </div>
        </div>
        <p class="demo-note">
          {business.name} is fictional. This is a concept demo by JS Web Services. The call button uses {business.phoneDisplay}, a number reserved for fiction. Prices, reviews, and licence numbers are examples.
        </p>
      </div>
    </article>
  </div>
</section>
