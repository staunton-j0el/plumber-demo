---
import { faqs } from "../data/site";

/** Questions as native disclosure widgets, so they work without JavaScript. */
---

<section id="faq" class="section bg-sand" aria-labelledby="faq-heading">
  <div class="mx-auto w-full max-w-3xl px-5">
    <p class="eyebrow">FAQ</p>
    <h2 id="faq-heading">Questions, answered plainly</h2>
    <p class="mt-3 text-lg leading-relaxed">
      Sample answers for the demo, including the important one: this is not a business you can book.
    </p>
    <div class="mt-8 grid gap-3">
      {
        faqs.map((item, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{item.question}</summary>
            <p class="faq-answer text-base leading-relaxed">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
